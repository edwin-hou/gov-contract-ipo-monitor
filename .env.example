# Required: identify your application and include a monitored contact email.
SEC_USER_AGENT=GovContractIPOMonitor/0.1 contact@example.com

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=alerts@example.com
SMTP_PASSWORD=replace-with-app-password-or-token
SMTP_SENDER=alerts@example.com
SMTP_RECIPIENTS=recipient@example.com

# Optional official/free enrichment sources
SAM_API_KEY=
TWELVE_DATA_API_KEY=

# Persistence
DATABASE_PATH=data/monitor.db
EVIDENCE_ARCHIVE_PATH=data/evidence

# Polling
SEC_INTERVAL_SECONDS=30
USASPENDING_INTERVAL_SECONDS=300
SAM_INTERVAL_SECONDS=21600
SMTP_POLL_SECONDS=5
SEC_FORMS=S-1,F-1,1-A,8-K,RW,AW

# Qualification
MAX_PRICE=5
MAX_MARKET_CAP=300000000
QUOTE_MAX_AGE_HOURS=24

# Health server
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080
