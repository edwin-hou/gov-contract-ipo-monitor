# Required: identify your application and include a monitored contact email.
SEC_USER_AGENT=CompanyTradeResearchMonitor/0.4 edwin.s.hou@gmail.com

# SMTP (Gmail example; create an App Password and keep it only in your local .env)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=edwin.s.hou@gmail.com
SMTP_PASSWORD=replace-with-google-app-password
SMTP_SENDER=edwin.s.hou@gmail.com
SMTP_RECIPIENTS=edwin.s.hou@gmail.com

# Optional official/free enrichment sources
SAM_API_KEY=
TWELVE_DATA_API_KEY=

# Persistence
DATABASE_PATH=data/monitor.db
EVIDENCE_ARCHIVE_PATH=data/evidence

# Polling
SEC_INTERVAL_SECONDS=30
USASPENDING_INTERVAL_SECONDS=300
USASPENDING_INITIAL_LOOKBACK_DAYS=7
USASPENDING_OVERLAP_DAYS=2
USASPENDING_MAX_PAGES=250
SAM_INTERVAL_SECONDS=21600
SMTP_POLL_SECONDS=5
SEC_FORMS=S-1,S-1/A,F-1,F-1/A,S-11,S-11/A,1-A,1-A/A,8-K,RW,AW,EFFECT,424B4
SEC_MAX_PAGES=3
# SEC response/decompressed text limit: 20 MiB by default, at most 50 MiB.
SEC_MAX_DOCUMENT_BYTES=20971520
SOURCE_TIMEOUT_SECONDS=600

# Public discourse. Comma-separated names and URLs; no API key required for RSS/seed metadata.
DISCOURSE_ENABLED=true
WATCH_COMPANIES=Anduril,SpaceX,OpenAI,Anthropic,Databricks,Stripe
NEWS_FEED_URLS=
YOUTUBE_VIDEO_URLS=https://youtu.be/0BE2AAOlYWI
YOUTUBE_API_KEY=
REDDIT_ENABLED=true
# Approved Reddit API access only. A bearer token or approved app credentials.
REDDIT_ACCESS_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
REDDIT_POSTS_PER_COMPANY=5
REDDIT_COMMENTS_PER_POST=10
REDDIT_MAX_COMMENTS_PER_RUN=60
FORUMS_ENABLED=true
# Public forum RSS/Atom URLs; excerpts are matched to watched company identities.
FORUM_FEED_URLS=https://forum.valuepickr.com/latest.rss
HACKER_NEWS_ENABLED=true
DISCOURSE_INTERVAL_SECONDS=3600
DISCOURSE_MAX_COMPANIES=30

# Global issuer shortlist selected from primary reported growth and profit.
# Blank WATCH_SYMBOLS uses the reviewed catalogue. Unknown symbols fail config
# rather than guessing an exchange, currency or company identity.
MARKETS_ENABLED=true
LISTED_DISCOVERY_ENABLED=true
LISTED_DISCOVERY_MAX_NEW_CIKS=5
LISTED_DISCOVERY_MAX_CANDIDATES=25
WATCH_SYMBOLS=
MARKET_INTERVAL_SECONDS=3600
FUNDAMENTAL_REFRESH_DAYS=7
FUNDAMENTAL_MAX_AGE_DAYS=120
PRICE_MAX_AGE_BUSINESS_DAYS=1

# Qualification
MAX_PRICE=5
MAX_MARKET_CAP=300000000
QUOTE_MAX_AGE_HOURS=24

# Health + read-only dashboard server
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080
